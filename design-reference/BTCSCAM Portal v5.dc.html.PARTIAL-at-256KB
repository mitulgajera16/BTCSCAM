<style>
*{box-sizing:border-box}
body{margin:0;background:#FCFBF9;color:#101010;font-family:Geist,system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{color:#101010;text-decoration:none;cursor:pointer}
a:hover{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
button{font-family:inherit;cursor:pointer}
input,textarea,select{font-family:inherit;font-size:16px}
::selection{background:#F7931A;color:#101010}
@keyframes tickmove{from{transform:translateX(0)}to{transform:translateX(-50%)}}
/* ── DESIGN TOKENS (Fix 1) ──────────────────────────────
   --paper:#FCFBF9  --ink:#101010
   --rule:#E4E1DB          (was E4E1DB, D8D3C7, E9E4D6)
   --surface-alt:#F1EDE2   (was F1EDE2, EFEBE1)
   --surface-dim:#F6F3EC
   --text-meta:#6E6A60     (was 8A857A — 3.5:1 → 5.4:1 AA)
   --accent-link:#9C5A06   (was C8730A — 3.4:1 → 4.9:1 AA)
   --brand:#F7931A         logo/brand marks ONLY — never buttons
   --action:#101010        primary CTAs (ink solid)
   --danger:#D2322E        scam alerts + verification failures only
   --safe:#1E7F4F          clean verdicts + confirmations
   Type scale (Pass 2 locked): 14 16 18 21 24 32 40 + d-page clamp(32,4.5vw,52) + d-hero clamp(40,5.5vw,72)
   Faces: Fraunces 600 (headlines/titles ONLY) · Geist (all UI/body/secondary) · 'IBM Plex Mono' (addresses/txids/prices ONLY)
   Weights: Geist 400/700 (900=stat numerals) · Fraunces 600 only · no italics anywhere
   Tracking: 0 sentence-case · .05em all-caps (.3em masthead tagline brand exception)
   Links: underline-on-hover (ink); accent #9C5A06 for prose links + trailheads only
   COMPONENT RECIPES (atomic): btn-primary = ink bg, 14px, hover #3A3833 · btn-ghost = transparent,
   1px ink border, hover fill ink · btn-quiet = borderless, hover #F1EDE2 · chip = 3px 9px, 700 14px
   · card = shadow token (no border) · overlay = heavy shadow tier · row-hover #F6F3EC, control-hover #F1EDE2
   Icons: Lucide, stroke 2.5 at 12-16px, stroke 2 at 20-24px
   Motion: 150ms color/bg transitions · 1px press translate · fadeUp .3s · reduced-motion kills all
──────────────────────────────────────────────────────── */
:focus-visible{outline:2px solid #101010;outline-offset:2px}
a,button{transition:color .15s ease,background-color .15s ease,border-color .15s ease,opacity .15s ease}
button:active{transform:translateY(1px)}
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important}}
@media (max-width:768px){
  /* HEADER: logo first, buttons split a row below; nav becomes a scroll strip */
  [data-masthead]{padding:20px 16px 14px!important}
  [data-masthead]>a{order:0!important;flex:1 1 100%!important}
  [data-masthead]>button{order:1!important;flex:1 1 44%!important}
  [data-mainnav]{flex-wrap:nowrap!important;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  [data-mainnav]::-webkit-scrollbar{display:none}
  [data-mainnav] button{white-space:nowrap}
  /* FRONT PAGE: image leads on mobile (New Yorker mobile order), rail cards stack with bottom rules */
  [data-lead-img]{order:-1}
  [data-railcard]{border-right:none!important;border-bottom:1px solid #E4E1DB!important;padding:22px 4px!important}
  [data-navmenu] button{min-height:44px}
  [data-navmenu]>div{min-width:min(240px,78vw)!important}
  button{min-height:44px}
  [data-screen-label] input, [data-screen-label] select, [data-screen-label] textarea{min-height:44px}
}
@media (max-width:768px){
  [data-dbrow]{display:block!important;position:relative;padding:14px 16px 16px!important}
  [data-dbrow]>span:first-child{display:inline-block;margin-bottom:6px}
  [data-dbrow]>span:last-child{position:absolute;top:14px;right:16px}
  [data-dbrow]>div{margin-top:8px}
  [data-dbrow]>div[style*="text-align:right"]{border-top:1px solid #E4E1DB;padding-top:8px;margin-top:12px}
}
@media (max-width:480px){
  /* GLOBAL: tighter gutters on every screen */
  [data-screen-label]{padding-left:16px!important;padding-right:16px!important}
  /* HEADER: date bar shows date only; masthead buttons full width */
  [data-datebar] span:nth-child(n+2){display:none}
  [data-masthead]>button{flex:1 1 100%!important}
  /* FRONT: Rug Report box breathes */
  [style*="border:3px double #101010"]{padding:28px 18px!important}
  /* FRONT: latest-row thumbs shrink */
  [data-latestrow]>div[aria-hidden="true"]{width:104px!important;height:70px!important}
  /* CHAT: smaller bubble, tucked in */
  [style*="width:64px;height:64px"]{width:56px!important;height:56px!important;right:14px!important;bottom:14px!important}
}
:root{--paper:#FCFBF9;--ink:#101010;--rule:#E4E1DB;--surface-alt:#F1EDE2;--surface-dim:#F6F3EC;--text-meta:#6E6A60;--accent-link:#9C5A06;--brand:#F7931A;--action:#101010;--danger:#D2322E;--safe:#1E7F4F}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.15}}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media(max-width:760px){[data-hero-cut]{inset:6% 6% 46% 6% !important}}
@media(max-width:1020px){[data-store-mosaic]{grid-template-columns:repeat(2,1fr) !important}}
@media(max-width:600px){[data-store-mosaic]{grid-template-columns:1fr !important;grid-auto-rows:auto !important}[data-store-mosaic]>div{grid-column:auto !important;grid-row:auto !important;min-height:380px}}
</style>
</helmet>
<a href="#main-content" style="position:absolute;left:-9999px;top:0;z-index:999;background:#101010;color:#FCFBF9;padding:10px 16px;font:700 16px Geist,sans-serif" style-focus="left:8px;top:8px">SKIP TO CONTENT</a>

<sc-if value="{{ toastShow }}" hint-placeholder-val="{{ false }}">
<div style="position:fixed;left:20px;bottom:20px;z-index:300;background:#0E0E0C;color:#FCFBF9;border-left:4px solid #F7931A;padding:14px 20px;font:700 16px Geist,sans-serif;box-shadow:0 10px 28px rgba(16,16,16,.3);animation:fadeUp .2s ease;max-width:min(420px,90vw)">{{ toastMsg }}</div>
</sc-if>

<sc-if value="{{ cartOpen }}" hint-placeholder-val="{{ false }}">
<div data-screen-label="Cart Drawer" style="position:fixed;top:0;right:0;bottom:0;z-index:295;width:min(420px,100vw);background:#FCFBF9;border-left:3px solid #101010;box-shadow:-14px 0 40px rgba(16,16,16,.25);display:flex;flex-direction:column;animation:fadeUp .2s ease">
  <div style="background:#101010;color:#FCFBF9;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px">
    <span style="font:600 18px Fraunces,Georgia,serif;letter-spacing:.05em">YOUR CART</span>
    <button onClick="{{ toggleCart }}" style="background:transparent;border:1px solid #54504A;color:#FCFBF9;font:700 14px Geist,sans-serif;padding:3px 10px" style-hover="border-color:#FCFBF9;color:#FCFBF9"><svg class="lucide lucide-x" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
  </div>
  <div style="flex:1;overflow-y:auto;padding:18px 20px">
    <sc-if value="{{ cartEmpty }}" hint-placeholder-val="{{ true }}">
      <div style="padding:30px 0;text-align:center">
        <sc-if value="{{ checkedOut }}" hint-placeholder-val="{{ false }}">
          <div style="display:inline-block;border:1px solid #1E7F4F;color:#1E7F4F;padding:14px 18px;font:700 16px Geist,sans-serif"><svg class="lucide lucide-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="vertical-align:-1px;margin-right:6px" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>ORDER PLACED — CONFIRMATION IN YOUR DESK</div>
        </sc-if>
        <div style="margin-top:14px;font:400 16px Geist,sans-serif;color:#6E6A60">Cart's empty. The swag funds the watch.</div>
        <button onClick="{{ goStoreFromCart }}" style="margin-top:16px;padding:12px 20px;font:700 14px Geist,sans-serif;background:#101010;color:#FCFBF9;border:1px solid #101010" style-hover="background:#3A3833">BROWSE THE STORE</button>
      </div>
    </sc-if>
    <sc-for list="{{ cartRows }}" as="c" hint-placeholder-count="2">
      <div style="display:flex;gap:14px;padding:14px 0;border-bottom:1px solid #E4E1DB;align-items:center">
        <div style="flex:none;width:64px;height:64px;background:repeating-linear-gradient(45deg,#F1EDE2 0 8px,#E4E1DB 8px 16px);border:1px solid #101010"></div>
        <div style="min-width:0;flex:1">
          <div style="font:700 16px Geist,sans-serif">{{ c.name }}</div>
          <div style="display:flex;gap:10px;align-items:center;margin-top:8px">
            <button onClick="{{ c.onDec }}" style="width:30px;height:30px;font:700 14px Geist,sans-serif;background:transparent;border:1px solid #101010" style-hover="background:#F1EDE2">−</button>
            <span style="font:700 16px Geist,sans-serif;min-width:22px;text-align:center">{{ c.qty }}</span>
            <button onClick="{{ c.onInc }}" style="width:30px;height:30px;font:700 14px Geist,sans-serif;background:transparent;border:1px solid #101010" style-hover="background:#F1EDE2">+</button>
            <button onClick="{{ c.onRm }}" style="margin-left:6px;font:700 14px Geist,sans-serif;background:transparent;border:none;color:#D2322E;padding:0" style-hover="color:#A02320">REMOVE</button>
          </div>
        </div>
        <span style="flex:none;font:700 18px Geist,sans-serif">{{ c.lineF }}</span>
      </div>
    </sc-for>
  </div>
  <sc-if value="{{ hasCartItems }}" hint-placeholder-val="{{ false }}">
    <div style="border-top:3px solid #101010;padding:18px 20px;background:#fff">
      <div style="display:flex;justify-content:space-between;font:700 18px Geist,sans-serif"><span>TOTAL</span><span style="font:700 21px Geist,sans-serif">{{ cartTotalF }}</span></div>
      <div style="margin-top:6px;font:400 16px Geist,sans-serif;color:#6E6A60">FREE SHIPPING OVER $50 · CRYPTO ONLY — BTC · LN · USDC</div>
      <button onClick="{{ checkout }}" style="margin-top:14px;width:100%;padding:15px;font:700 14px Geist,sans-serif;letter-spacing:.05em;background:#101010;color:#FCFBF9;border:1px solid #101010" style-hover="background:#3A3833">CHECKOUT →</button>
      <div style="margin-top:10px;text-align:center;font:400 14px Geist,sans-serif;color:#6E6A60">Ships worldwide · 30-day returns · 100% of profit funds the watchdesk</div>
    </div>
  </sc-if>
</div>
</sc-if>

<sc-if value="{{ chatOpen }}" hint-placeholder-val="{{ false }}">
<div data-screen-label="Live Chat" style="position:fixed;right:20px;bottom:96px;z-index:290;width:min(370px,calc(100vw - 40px));background:#fff;border:1px solid #101010;box-shadow:0 14px 40px rgba(16,16,16,.35);display:flex;flex-direction:column;animation:fadeUp .2s ease">
  <div style="background:#0E0E0C;color:#FCFBF9;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px">
    <span style="display:inline-flex;align-items:center;gap:9px;font:700 16px Geist,sans-serif;letter-spacing:.05em"><span style="width:9px;height:9px;background:#3FBF6F;animation:blink 1.3s infinite"></span>LIVE WATCHDESK</span>
    <button onClick="{{ toggleChat }}" style="background:transparent;border:1px solid #54504A;color:#FCFBF9;font:700 14px Geist,sans-serif;padding:2px 9px" style-hover="border-color:#FCFBF9;color:#FCFBF9"><svg class="lucide lucide-x" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
  </div>
  <div id="chatlog" style="max-height:320px;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:#FCFBF9">
    <sc-for list="{{ chatMsgs }}" as="m" hint-placeholder-count="2">
      <div style="{{ m.rowStyle }}"><div style="{{ m.bubStyle }}">{{ m.t }}</div></div>
    </sc-for>
  </div>
  <div style="display:flex;gap:8px;padding:12px;border-top:2px solid #101010;background:#fff">
    <input value="{{ chatDraft }}" onChange="{{ onChatDraft }}" onKeyDown="{{ onChatKey }}" placeholder="Type a message…" style="flex:1;min-width:0;border:1px solid #101010;padding:11px 12px;background:#FCFBF9;font-size:16px;outline-color:#101010">
    <button onClick="{{ sendChat }}" style="padding:11px 16px;font:700 14px Geist,sans-serif;background:#101010;color:#FCFBF9;border:1px solid #101010" style-hover="background:#3A3833">SEND</button>
  </div>
  <div style="padding:8px 12px;background:#F6F3EC;border-top:1px solid #E4E1DB;font:400 16px Geist,sans-serif;color:#6E6A60">VOLUNTEER WATCHMEN · HUMANS, NOT BOTS</div>
</div>
</sc-if>
<button onClick="{{ toggleChat }}" aria-label="Live chat with the watchdesk" style="position:fixed;right:20px;bottom:20px;z-index:290;width:56px;height:56px;border-radius:50%;background:#101010;border:none;color:#FCFBF9;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 6px 20px rgba(16,16,16,.3);transition:transform .15s ease,box-shadow .15s ease" style-hover="transform:scale(1.06) !important;box-shadow:0 10px 28px rgba(16,16,16,.4) !important">
  <sc-if value="{{ chatClosed }}" hint-placeholder-val="{{ true }}">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
    <span style="position:absolute;top:2px;right:2px;width:12px;height:12px;border-radius:50%;background:#3FBF6F;border:2px solid #FCFBF9" aria-hidden="true"></span>
  </sc-if>
  <sc-if value="{{ chatOpen }}" hint-placeholder-val="{{ false }}">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </sc-if>
</button>

<div data-screen-label="Crypto Ticker" style="background:#0E0E0C;color:#CFC7B8;border-bottom:1px solid #101010;display:flex;align-items:stretch">
    <div style="overflow:hidden;flex:1">
    <div style="display:flex;width:max-content;animation:tickmove {{ tickerDur }} linear infinite;animation-play-state:{{ tickerPlay }}" style-hover="animation-play-state:paused">
      <sc-for list="{{ tickerLoop }}" as="t" hint-placeholder-count="8">
        <div style="display:flex;align-items:center;gap:10px;padding:9px 22px;border-right:1px solid #26261F;font:400 14px Geist,sans-serif;white-space:nowrap">
          <sc-if value="{{ t.isPrice }}" hint-placeholder-val="{{ true }}">
            <span style="font:600 14px 'IBM Plex Mono',monospace;color:#8A857A">{{ t.sym }}</span>
            <span style="font:500 14px 'IBM Plex Mono',monospace;color:#FCFBF9">{{ t.px }}</span>
            <span style="font:600 14px 'IBM Plex Mono',monospace;color:{{ t.chgColor }}">{{ t.chg }}</span>
          </sc-if>
          <sc-if value="{{ t.alert }}" hint-placeholder-val="{{ false }}">
            <span style="background:#D2322E;color:#fff;padding:2px 9px;font:400 14px Geist,sans-serif;letter-spacing:.05em">SCAM ALERT</span>
            <a onClick="{{ goAlerts }}" tabindex="-1" style="color:#FCFBF9;cursor:pointer" style-hover="text-decoration:underline;text-underline-offset:3px">{{ t.text }}</a>
          </sc-if>
        </div>
      </sc-for>
    </div>
  </div>
</div>

<div style="background:#FEF3E2">
<div data-masthead style="max-width:1280px;margin:0 auto;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px 20px;flex-wrap:wrap">
  <button onClick="{{ goNews }}" style="order:1;padding:12px 20px;font:400 14px Geist,sans-serif;letter-spacing:.05em;background:transparent;color:#101010;border:1px solid #101010" style-hover="background:#101010;color:#FCFBF9">SUBSCRIBE</button>
  <a href="#/home" onClick="{{ goHome }}" style="order:2;display:block;text-align:center;flex:1 1 auto;min-width:0" style-hover="text-decoration:none !important">
    <div style="font:600 40px/1 Fraunces,Georgia,serif;letter-spacing:.005em">
      <span style="color:#F7931A">BTC</span><span style="color:#101010;text-decoration:line-through;text-decoration-color:#D2322E;text-decoration-thickness:4px">SCAM</span>
    </div>
  </a>
  <button onClick="{{ goWalletTest }}" style="order:3;padding:12px 20px;font:400 14px Geist,sans-serif;letter-spacing:.05em;background:transparent;color:#101010;border:1px solid #101010;cursor:pointer" style-hover="background:#101010;color:#FCFBF9">WALLET TEST</button>
</div>
</div>

<div style="position:sticky;top:0;z-index:100;background:#FEF3E2;border-top:1px solid #101010;border-bottom:3px double #101010">
  <div style="max-width:1280px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <div data-mainnav style="display:flex;flex-wrap:wrap;align-items:baseline">
      <sc-for list="{{ navMenus }}" as="n" hint-placeholder-count="5">
        <div style="position:relative" data-navmenu="1" onMouseEnter="{{ n.onEnter }}" onMouseLeave="{{ n.onLeave }}">
          <button onClick="{{ n.on }}" style="{{ n.style }}" style-hover="color:#9C5A06 !important">{{ n.label }}<sc-if value="{{ n.isDrop }}" hint-placeholder-val="{{ false }}"><span style="font:400 14px Geist,sans-serif;color:#6E6A60">{{ n.caret }}</span></sc-if></button>
          <sc-if value="{{ n.open }}" hint-placeholder-val="{{ false }}">
            <div style="position:absolute;top:100%;left:0;z-index:150;min-width:240px;background:#FCFBF9;border:1px solid #101010;animation:fadeUp .15s ease">
              <sc-for list="{{ n.items }}" as="it" hint-placeholder-count="4">
                <a href="{{ it.href }}" onClick="{{ it.on }}" style="{{ it.style }}" style-hover="background:#F1EDE2">{{ it.label }}</a>
              </sc-for>
            </div>
          </sc-if>
        </div>
      </sc-for>
    </div>
    <div style="display:flex;gap:22px;padding:9px 0;font:400 16px Geist,sans-serif;align-items:center">
      <a onClick="{{ toggleCart }}" style="color:#54504A;display:inline-flex;align-items:center;gap:7px" style-hover="text-decoration:underline;text-underline-offset:4px">CART<sc-if value="{{ cartBadge }}" hint-placeholder-val="{{ false }}"><span style="background:#101010;color:#FCFBF9;font:400 16px Geist,sans-serif;padding:0 8px;border:1px solid #101010">{{ cartCount }}</span></sc-if></a>
      <a href="#/user" onClick="{{ goUser }}" style="color:#54504A" style-hover="text-decoration:underline;text-underline-offset:4px">MY DESK</a>
      <button onClick="{{ goReport }}" style="padding:9px 16px;font:400 14px Geist,sans-serif;letter-spacing:.05em;background:#101010;color:#FCFBF9;border:1px solid #101010;cursor:pointer" style-hover="background:#3A3833">REPORT A SCAM</button>
    </div>
  </div>
</div>

<div id="main-content"></div>

<sc-if value="{{ isHome }}" hint-placeholder-val="{{ true }}">
<div data-screen-label="Home">
  <div data-screen-label="Front Page" style="max-width:1140px;margin:0 auto;padding:0 24px;animation:fadeUp .3s ease">
    <div onClick="{{ lead.on }}" role="img" aria-label="{{ lead.img }}" style="position:relative;cursor:pointer;width:100vw;margin-left:calc(50% - 50vw);min-height:calc(100vh - 220px);display:flex;align-items:flex-end;justify-content:center;overflow:hidden;background:#DD1E7A">
      <div data-hero-cut="1" style="position:absolute;inset:7% 5% 11% 49%;background-color:#FCFBF9;background-image:url({{ leadImgSrc }});background-size:cover;background-position:center;filter:grayscale(1) contrast(1.95) brightness(1.1);box-shadow:0 0 0 6px #FCFBF9,8px 10px 0 rgba(16,16,16,.45);transform:rotate(-1.4deg)"></div><div data-hero-cut="1" aria-hidden="true" style="position:absolute;inset:7% 5% 11% 49%;pointer-events:none;background-image:radial-gradient(#101010 30%,transparent 31%);background-size:4px 4px;mix-blend-mode:multiply;opacity:.5;transform:rotate(-1.4deg)"></div>
      <span aria-hidden="true" style="position:absolute;top:7%;right:6%;pointer-events:none;font:700 clamp(34px,4vw,68px)/1 Geist,sans-serif;color:#F5E14B;transform:rotate(-14deg);text-shadow:2px 2px 0 rgba(16,16,16,.22)">★</span>
